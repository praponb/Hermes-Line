# Copy to deploy/.env (git-ignored) and fill in.
HERMES_IMAGE=hermes-agent:f7b26ef
HERMES_DATA=/home/prapon/.hermes
# Daily backup zips (deploy/backup.sh)
HERMES_BACKUPS=/home/prapon/hermes-backups
HERMES_UID=1000
HERMES_GID=1000
# Token of tunnel "hermes-line": cloudflared tunnel token hermes-line
CLOUDFLARE_TUNNEL_TOKEN=
# Token of tunnel "hermes-finops" (finops.praponb.com): cloudflared tunnel token hermes-finops
FINOPS_TUNNEL_TOKEN=
